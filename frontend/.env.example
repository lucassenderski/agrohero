# ==========================================================
# AgroHero FRONTEND - modelo de variaveis de ambiente
# ==========================================================
# Copie para ".env" e ajuste conforme o ambiente.
#
# IMPORTANTE: tudo que comeca com VITE_ vai para o bundle do navegador
# e e PUBLICO. Nunca coloque segredo aqui (nem JWT_SECRET, nem senha
# de banco, nem token de gateway).
# ==========================================================

# URL base da API do AgroHero (sem barra no final)
VITE_API_URL=http://localhost:3001/api/v1

# Nome exibido na interface
VITE_APP_NOME=AgroHero