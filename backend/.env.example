# ==========================================================
# AgroHero BACKEND - modelo de variaveis de ambiente
# ==========================================================
# Copie este arquivo para ".env" e preencha os valores reais.
#
#   cp .env.example .env
#
# O arquivo .env NUNCA deve ser versionado (ja esta no .gitignore).
# Este arquivo .env.example NAO pode conter segredos de verdade.
# ==========================================================

# --- Servidor ---
NODE_ENV=development
PORT=3001

# --- PostgreSQL ---
# Em desenvolvimento local usamos o Docker Compose da raiz do projeto,
# que publica o banco na porta 5433 do host.
DATABASE_URL=postgresql://agrohero:troque_esta_senha@localhost:5433/agrohero

# Usado apenas pelos TESTES de integracao (banco separado e descartavel).
DATABASE_URL_TEST=postgresql://agrohero:troque_esta_senha@localhost:5433/agrohero_test

# --- Autenticacao ---
# Gere um valor aleatorio forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_aleatoria_longa_e_secreta
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12

# --- CORS ---
# Lista separada por virgula. NUNCA use "*" em producao com credenciais.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limit ---
RATE_LIMIT_JANELA_MINUTOS=15
RATE_LIMIT_MAX_REQUISICOES=300
RATE_LIMIT_MAX_LOGIN=10

# --- Pagamentos ---
# fake | mercadopago
PAYMENT_GATEWAY=fake
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Imagens ---
# local | cloudinary
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frete ---
# Valor fixo cobrado por pedido, em reais (regra simples inicial)
FRETE_VALOR_BASE=9.90
FRETE_GRATIS_ACIMA_DE=200.00